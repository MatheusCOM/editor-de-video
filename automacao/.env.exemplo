# Copie para automacao/.env e preencha. NUNCA envie o .env para o GitHub nem por chat.

# --- Telegram ---
TELEGRAM_TOKEN=            # do @BotFather
TELEGRAM_API_ID=           # de https://my.telegram.org (API development tools)
TELEGRAM_API_HASH=
TELEGRAM_USUARIOS=         # IDs autorizados separados por vírgula (mande /id ao bot para descobrir)
# TELEGRAM_CHAT_AVISOS=    # opcional: para onde vão avisos do sistema (padrão: primeiro ID)

# --- Anthropic (cérebro da edição) ---
ANTHROPIC_API_KEY=         # https://console.anthropic.com
MODELO_EDITOR=claude-opus-5-5
MODELO_INTERPRETADOR=claude-haiku-5-5
ESFORCO_EDITOR=high
TETO_USD_POR_JOB=3         # limite de gasto por vídeo (o agente para se passar)

# --- Instagram (Graph API oficial) ---
IG_USER_ID=                # ID da conta profissional do Instagram
IG_TOKEN=                  # token com instagram_content_publish (recomendado: usuário do sistema, não expira)
GRAPH_VERSAO=v23.0

# --- Geral ---
MODO_ENSAIO=1              # 1 = faz tudo menos publicar de verdade. Troque para 0 quando estiver tudo certo.
MARCA_PADRAO=icg
FUSO=America/Sao_Paulo
HORA_HEARTBEAT=9           # hora do aviso diário "estou no ar"
# EDITOR_SIMULADO=1        # testes sem gastar tokens: não edita, só repassa o vídeo
