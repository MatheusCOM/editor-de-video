    {"type": "logo", "anchor": "full", "props": {"position": "top-left", "opacity": 0.75}},
    {"type": "title", "anchor": "start", "duration": 2.8, "props": {"text": "{{GANCHO}}", "position": "top", "size": 0.075, "uppercase": false, "stroke": 0, "animation": "slide"}},
    {"type": "assinatura", "anchor": "start", "offset": 3.0, "duration": 3.5, "props": {"position": 0.52}},
    {"type": "progress", "anchor": "full", "props": {"position": "bottom", "height": 4}},
    {"type": "cta", "anchor": "end", "duration": 3.5, "props": {"title": "{{CTA_TITULO}}", "button": "Agende sua avaliação", "mode": "full", "uppercase": false, "weight": 300}}
  ],
  "grade": {"contrast": 1.04, "saturation": 0.95},
